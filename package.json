{
  "name": "nottshack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o css/tailwind.css --minify",
    "build": "npm run build:css && rm -rf dist && mkdir dist && cp -r index.html robots.txt css js assets dist/",
    "dev": "tailwindcss -i src/tailwind.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
